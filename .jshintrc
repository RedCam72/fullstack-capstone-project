{
  "esversion": 6,
  "node": true,
  "strict": false,
  "globals": {
    "describe": false,
    "it": false,
    "before": false,
    "after": false,
    "beforeEach": false,
    "afterEach": false
  },
  "curly": true,
  "eqeqeq": true,
  "immed": true,
  "latedef": false,
  "newcap": true,
  "noarg": true,
  "nonew": true,
  "plusplus": false,
  "undef": true,
  "unused": true,
  "trailing": true,
  "indent": 4
}
